{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "katazuku workflow contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "database", "firstStep", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRole"],
      "properties": { "requiredRole": { "enum": ["canonical", "any"] } }
    },
    "firstStep": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "sideEffect", "capabilities", "approval", "idempotency", "next"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "owner": { "enum": ["trigger", "executor", "agent", "user"] },
          "sideEffect": { "enum": ["none", "db-write", "external-draft", "internal-sync", "third-party-commit"] },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "inputSchema": { "type": "string", "minLength": 1 },
          "outputSchema": { "type": "string", "minLength": 1 },
          "approval": { "enum": ["none", "user"] },
          "requiresApprovalFrom": { "type": "string", "minLength": 1 },
          "idempotency": { "enum": ["not-applicable", "run-step", "external-key"] },
          "next": { "type": ["string", "null"] }
        }
      }
    }
  }
}
