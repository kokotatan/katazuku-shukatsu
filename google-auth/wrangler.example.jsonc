{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "katazuku-google-auth-example",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // OAuth callbackのURL・認可コードを実行ログへ保存しない。
  "observability": { "enabled": false },
  "secrets": { "required": ["GOOGLE_CLIENT_SECRET", "STATE_SIGNING_SECRET"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://auth.example.com",
    "GOOGLE_CLIENT_ID": "configure-google-web-client.apps.googleusercontent.com"
  }
}
