{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "katazuku-muse-gateway",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "PUBLIC_ORIGIN": "https://muse.example.com" },
  "secrets": { "required": ["OWNER_KEY_SHA256", "BRIDGE_TOKEN"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "MuseRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MuseRelay"] }]
}
