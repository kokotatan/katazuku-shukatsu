{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "本人へ提示し、そのまま送信する第三者宛メール",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionType", "target", "content", "effectiveAt", "notification"],
  "properties": {
    "actionType": { "const": "gmail.send" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userGoogleEmail", "to", "companyName"],
      "properties": {
        "userGoogleEmail": { "type": "string", "format": "email" },
        "to": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "email" } },
        "cc": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "email" } },
        "bcc": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "email" } },
        "companyName": { "type": "string", "minLength": 1 },
        "selectionId": { "type": "integer", "minimum": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body", "threadId", "sourceMessageId", "scheduleCommitments"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "threadId": { "type": "string", "minLength": 1 },
        "sourceMessageId": { "type": "string", "minLength": 1 },
        "inReplyTo": { "type": "string" },
        "references": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "filename", "mimeType"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "filename": { "type": "string", "minLength": 1 },
              "mimeType": { "type": "string", "minLength": 1 }
            }
          }
        },
        "scheduleCommitments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startAt", "endAt"],
            "properties": {
              "startAt": { "type": "string", "minLength": 1 },
              "endAt": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "effectiveAt": { "const": "immediate" },
    "notification": { "type": "string", "minLength": 1 }
  }
}
