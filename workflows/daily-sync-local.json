{
  "$schema": "../schemas/workflow-contract.schema.json",
  "schemaVersion": 1,
  "id": "daily-sync-local",
  "version": 1,
  "title": "取得済みメールから正本DBを更新する日次同期",
  "database": { "requiredRole": "canonical" },
  "firstStep": "prepare",
  "steps": [
    { "id": "prepare", "title": "正本DBと入力を固定する", "owner": "executor", "sideEffect": "none", "capabilities": [], "approval": "none", "idempotency": "run-step", "next": "extract" },
    { "id": "extract", "title": "取得済みメールJSONから構造化提案を作る", "owner": "agent", "sideEffect": "none", "capabilities": ["workspace.read"], "outputSchema": "../schemas/daily-sync-result.schema.json", "approval": "none", "idempotency": "run-step", "next": "validate" },
    { "id": "validate", "title": "提案をSchema・網羅性・業務規則で検証する", "owner": "executor", "sideEffect": "none", "capabilities": [], "approval": "none", "idempotency": "run-step", "next": "apply" },
    { "id": "apply", "title": "専用関数で正本DBへ反映する", "owner": "executor", "sideEffect": "db-write", "capabilities": [], "approval": "none", "idempotency": "external-key", "next": "snapshot" },
    { "id": "snapshot", "title": "機密分離済みsnapshotとbackupを更新する", "owner": "executor", "sideEffect": "internal-sync", "capabilities": [], "approval": "none", "idempotency": "run-step", "next": "audit" },
    { "id": "audit", "title": "活動ログへ結果を記録する", "owner": "executor", "sideEffect": "internal-sync", "capabilities": [], "approval": "none", "idempotency": "run-step", "next": null }
  ]
}
