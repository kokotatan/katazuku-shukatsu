{
  "name": "katazuku-shukatsu",
  "version": "0.1.0",
  "description": "Local-first, human-in-the-loop automation core for Japanese shukatsu (new-grad job hunting). SQLite single-writer data model, semantic layer, and a schema-driven settings UI.",
  "license": "Apache-2.0",
  "author": "kokotatan",
  "keywords": ["shukatsu", "job-hunting", "sqlite", "agent", "human-in-the-loop", "local-first", "automation"],
  "repository": { "type": "git", "url": "git+https://github.com/kokotatan/katazuku-shukatsu.git" },
  "bugs": { "url": "https://github.com/kokotatan/katazuku-shukatsu/issues" },
  "homepage": "https://github.com/kokotatan/katazuku-shukatsu#readme",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check": "npm run scan && npm test",
    "scan": "node tools/scan-secrets.mjs",
    "test": "npm run test:core && npm run test:application && npm run test:mobility && npm run test:agent-runtime",
    "test:core": "tsx tests/check-core.ts",
    "test:application": "tsx tests/check-application.ts",
    "test:mobility": "tsx tests/check-mobility.ts",
    "test:agent-runtime": "tsx tests/check-agent-runtime.ts",
    "seed": "tsx examples/seed.ts",
    "doctor": "node tools/doctor.mjs",
    "backup": "node tools/backup.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
