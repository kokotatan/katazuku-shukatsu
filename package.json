{
  "name": "katazuku-shukatsu",
  "version": "0.2.0",
  "description": "Local-first, human-in-the-loop automation core for Japanese shukatsu (new-grad job hunting). SQLite single-writer data model, semantic layer, and a schema-driven settings UI.",
  "license": "Apache-2.0",
  "author": "kokotatan",
  "keywords": [
    "shukatsu",
    "job-hunting",
    "sqlite",
    "agent",
    "human-in-the-loop",
    "local-first",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kokotatan/katazuku-shukatsu.git"
  },
  "bugs": {
    "url": "https://github.com/kokotatan/katazuku-shukatsu/issues"
  },
  "homepage": "https://github.com/kokotatan/katazuku-shukatsu#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check": "npm run scan && npm run typecheck && npm run build && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "scan": "node tools/scan-secrets.mjs",
    "test": "npm run test:core && npm run test:application && npm run test:mobility && npm run test:agent-runtime && npm run test:platform && npm run test:migration && npm run test:write-layer && npm run test:data-path && npm run test:google-workspace && npm run test:scan-secrets && npm run test:api && npm run test:schema",
    "test:core": "tsx tests/check-core.ts",
    "test:schema": "tsx tests/check-schema.ts",
    "test:platform": "tsx tests/check-platform.ts",
    "test:api": "tsx tests/check-api.ts",
    "test:application": "tsx tests/check-application.ts",
    "test:mobility": "tsx tests/check-mobility.ts",
    "test:agent-runtime": "tsx tests/check-agent-runtime.ts",
    "seed": "tsx examples/seed.ts",
    "doctor": "node tools/doctor.mjs",
    "setup:google": "node tools/setup-google-workspace.mjs",
    "backup": "node tools/backup.mjs",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "test:write-layer": "tsx tests/check-write-layer.ts",
    "test:migration": "tsx tests/check-migration.ts",
    "test:data-path": "tsx tests/check-data-path.ts",
    "test:google-workspace": "tsx tests/check-google-workspace.ts",
    "test:scan-secrets": "tsx tests/check-scan-secrets.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
