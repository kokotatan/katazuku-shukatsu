# Copy this file to .env. Keep secrets only in .env; never commit them.
# Google: optional when these values are already stored by workspace-mcp.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional API providers. Leave blank when using Claude Code / Codex / ChatGPT.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KATAZUKU_OPENAI_MODEL=

# Optional absolute CLI paths when a scheduler cannot find your login-installed CLI.
# KATAZUKU_CLAUDE_COMMAND=
# KATAZUKU_CODEX_COMMAND=
