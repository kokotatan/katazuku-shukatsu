# Copy this file to .env. Keep secrets only in .env; never commit them.
# Google: your own Desktop OAuth client for npm run google:connect.
# Existing workspace-mcp credentials can supply these values for read workflows.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Workspace MCP is launched through scripts/google-workspace-bridge.mjs.
# The bridge supplies per-run capabilities and account boundaries automatically.
# Optional custom upstream only; do not put approved mail content in .env.
# KATAZUKU_GOOGLE_MCP_COMMAND=uvx
# KATAZUKU_GOOGLE_MCP_ARGS_JSON=["workspace-mcp","--tools","gmail","calendar"]

# Optional API providers. Leave blank when using Claude Code / Codex / ChatGPT.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KATAZUKU_OPENAI_MODEL=

# Optional absolute CLI paths when a scheduler cannot find your login-installed CLI.
# KATAZUKU_CLAUDE_COMMAND=
# KATAZUKU_CODEX_COMMAND=

# Optional: interview transcription (docs/TRANSCRIPTION.md). No secrets here.
# KATAZUKU_FFMPEG=
# KATAZUKU_VOICEBOX_MCP_URL=http://127.0.0.1:17493/mcp
# KATAZUKU_VOICEBOX_COMMAND=
# KATAZUKU_PYTHON=
# KATAZUKU_WHISPER_MODEL=large-v3-turbo
